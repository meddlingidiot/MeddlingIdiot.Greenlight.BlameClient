<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A consumer of MeddlingIdiot.Greenlight.Sdk that is invisible almost all of the time. There
    is no desktop widget, no tray colour to watch, nothing sitting in the corner being green
    at you. It waits, and the moment a pipeline goes from working to broken it throws the name
    of whoever pushed it across the whole screen in letters a room can read.

    Then it goes away again. That restraint is the entire design: a notice that is always on
    screen is wallpaper within a week, and wallpaper does not make anybody fix a build.

    The point of it is what it does NOT have. No Azure DevOps client, no GitHub client, no
    token, no polling loop - it reads everything from the Greenlight already running on the
    machine, through the package. Everything here is either Avalonia drawing, the tray icon,
    or the twenty-odd lines that talk to the SDK.

    It references the SDK as a package, which is all an app of your own has to do:
      dotnet add package MeddlingIdiot.Greenlight.Sdk

    net10.0-windows because the always-on-top maths and the Run key are Win32. The SDK itself
    is plain net8.0/net10.0.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Greenlight.BlameClient</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MeddlingIdiot.ico</ApplicationIcon>
    <!-- Not a package. Fallout's Package target packs the whole solution. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <!-- The SDK and the updater, the same way your own app would take them. -->
  <ItemGroup>
    <PackageReference Include="MeddlingIdiot.Greenlight.Sdk" Version="1.2.0" />
    <PackageReference Include="MeddlingIdiot.Velopack" Version="1.2.1" />
  </ItemGroup>

  <!--
    The mascot, for the tray icon and the executable. Same icon the other apps use, and like
    theirs NOT under the MIT licence - see TRADEMARKS.md. The licence notice beside it is for
    people, not for the app.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\LICENSE" />
  </ItemGroup>
</Project>
